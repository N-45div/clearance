{
  "name": "clearance",
  "private": true,
  "type": "module",
  "description": "Clear your Go fleet for a new CVE: every service gets \"affected\" with the call path, or \"not affected\" with the proof, from a FalkorDB graph.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --no-warnings --env-file-if-exists=.env src/main.ts",
    "build": "vite build web",
    "dev:web": "vite web",
    "pin": "node --no-warnings --env-file-if-exists=.env src/ingest/pin.ts",
    "ingest": "node --no-warnings --env-file-if-exists=.env src/ingest/run.ts",
    "decide": "node --no-warnings --env-file-if-exists=.env src/graph/verdicts.ts",
    "feed": "node --no-warnings --env-file-if-exists=.env src/ingest/feed.ts",
    "check": "node --no-warnings --env-file-if-exists=.env src/check.ts",
    "test": "node --no-warnings --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@vercel/functions": "^3.10.1",
    "falkordb": "^6.8.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@falkordb/canvas": "^0.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
